# ─────────────────────────────────────────────────────────────
# ushbooknpay — Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ──── Service Identity ────────────────────────────────────────
APP_ENV=development              # development | staging | production
APP_DEBUG=true
APP_NAME=ushbooknpay
APP_VERSION=1.0.0
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ──── HTTP Server ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
WORKERS=1                        # Set > 1 in production

# ──── Database (PostgreSQL async) ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://ushbooknpay:changeme@localhost:5432/ushbooknpay
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ──── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5

# ──── Security ────────────────────────────────────────────────
# USHSPA application token — never log this
USHSPA_TOKEN=your-secret-application-token-here

# JWT public key (RS256) from ushauth — PEM format, newlines as \n
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w...\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
JWT_AUDIENCE=ushspa
JWT_ISSUER=ushauth

# ──── API Gateway ─────────────────────────────────────────────
API_GATEWAY_BASE_URL=http://api.ushspa.local
USHAUTH_BASE_PATH=/uauth
USHBOOKNPAY_BASE_PATH=/booknpay
USHNOTICE_BASE_PATH=/unotice

# Direct inter-service URL for ushauth — bypasses the API gateway.
# Set to the ushauth service URL reachable from this container.
# Examples:
#   Docker (host networking): http://host.docker.internal:8002
#   Docker (shared network):  http://ushauth:8002
#   Leave empty to fall back to API_GATEWAY_BASE_URL + USHAUTH_BASE_PATH.
USHAUTH_DIRECT_URL=http://host.docker.internal:8002

# Inter-service request timeout in seconds
GATEWAY_TIMEOUT=10

# ──── AWS ─────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# AWS_SESSION_TOKEN is optional — only set for temporary/STS credentials
AWS_SESSION_TOKEN=

# SQS queue for publishing events (consumed by notification service)
AWS_SQS_NOTIFICATION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789/ushspa-notification

AWS_S3_BUCKET=ushspa-media

# ──── Payment Providers ───────────────────────────────────────
# MyFatoorah
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://api.myfatoorah.com   # Use https://apitest.myfatoorah.com for test
MYFATOORAH_CALLBACK_URL=https://api.ushspa.co/booknpay/api/v1/payments/webhook/myfatoorah/
MYFATOORAH_SUCCESS_URL=https://app.ushspa.co/booking/success
MYFATOORAH_ERROR_URL=https://app.ushspa.co/booking/failed

# Tap Payments
TAP_SECRET_KEY=
TAP_BASE_URL=https://api.tap.company/v2
TAP_CALLBACK_URL=https://api.ushspa.co/booknpay/api/v1/payments/webhook/tap/
TAP_REDIRECT_URL=https://app.ushspa.co/booking/success

# ──── Availability Engine ─────────────────────────────────────
AVAILABILITY_DAYS_AHEAD=10          # Number of days to compute in availability response
HOME_SERVICE_BUFFER_MINUTES=30      # Buffer before/after home service bookings
TEMPORARY_HOLD_MINUTES=15           # How long a booking hold lasts before auto-expiry
SLOT_DURATION_MINUTES=30            # Size of each availability block

# ──── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_REQUESTS=100             # requests per window
RATE_LIMIT_WINDOW_SECONDS=60

# ──── Idempotency ─────────────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=86400       # 24 hours

# ──── Caching ─────────────────────────────────────────────────
CATALOG_CACHE_TTL_SECONDS=300       # 5 minutes for branch/service/therapist data
